# TrustLens AI Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your credentials if available.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Configuration (MongoDB)
# If local MongoDB is not running, TrustLens automatically uses safe local JSON storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=trustlens_db

# Optional LLM API Keys (Demo mode works out-of-the-box without keys!)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_MODEL=gemini-1.5-flash

